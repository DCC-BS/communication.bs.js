{
    "name": "@dcc-bs/communication.bs.js",
    "module": "./dist/communication.bs.js",
    "main": "./dist/communication.bs.umd.cjs",
    "type": "module",
    "version": "0.1.4",
    "types": "./dist/communication.bs.d.ts",
    "repository": {
        "url": "https://github.com/DCC-BS/communication.bs.js"
    },
    "declaration": true,
    "exports": {
        ".": {
            "import": {
                "types": "./dist/communication.bs.d.ts",
                "default": "./dist/communication.bs.js"
            },
            "require": {
                "types": "./dist/communication.bs.d.cts",
                "default": "./dist/communication.bs.umd.cjs"
            }
        }
    },
    "files": [
        "./dist",
        "README.md"
    ],
    "scripts": {
        "check": "biome check --write",
        "build": "vite build && cp dist/communication.bs.d.ts dist/communication.bs.d.cts",
        "test": "vitest",
        "test:unit": "vitest run",
        "test:debug": "node --inspect-brk node_modules/vitest/vitest.mjs run --no-file-parallelism"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.15",
        "@microsoft/api-extractor": "^7.55.1",
        "@types/bun": "latest",
        "publint": "^0.3.25",
        "vite-plugin-dts": "^5.0.0",
        "vitest": "^5.0.0"
    },
    "peerDependencies": {
        "typescript": "^5 || ^7.0.0"
    },
    "dependencies": {
        "vite": "^8.0.0",
        "vue": "^3.5.25",
        "zod": "^4.1.9"
    },
    "publishConfig": {
        "access": "public"
    }
}
